includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
    ignoreErrors:
        # Larastan types QueryBuilder::for() as Eloquent Builder, missing Spatie QueryBuilder methods
        - identifier: method.notFound
          path: app/Repositories/CompanyRepository.php
        - identifier: method.notFound
          path: app/Repositories/JobRepository.php
        - identifier: method.notFound
          path: app/Repositories/ApplicationRepository.php
